# =========================================================
# Plantilla de variables de entorno.
# 1) Copia este archivo y renómbralo a  .env  (sin ".example")
# 2) Llena tus valores reales en .env
# 3) .env NUNCA se sube a GitHub (está en .gitignore)
# =========================================================

# ---- PostgreSQL (se usa desde la Fase 4) ----
PG_HOST=localhost
PG_PORT=5432
PG_DB=cobranza
PG_USER=postgres
PG_PASSWORD=cambia_esta_clave

# ---- Kaggle (se usa en la Fase 2) ----
KAGGLE_USERNAME=tu_usuario_kaggle
KAGGLE_KEY=tu_clave_api_kaggle
