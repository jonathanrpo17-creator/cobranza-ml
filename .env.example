# =========================================================
# Plantilla de variables de entorno.
# 1) Copia este archivo y renómbralo a  .env  (sin ".example")
# 2) Llena tus valores reales en .env
# 3) .env NUNCA se sube a GitHub (está en .gitignore)
# 4) Este archivo (.env.example) SÍ se sube: solo valores de ejemplo
# =========================================================

# ---- PostgreSQL: administrador (carga los datos desde los notebooks) ----
PG_HOST=localhost
PG_PORT=5432
PG_DB=cobranza
PG_USER=postgres
PG_PASSWORD=cambia_esta_clave

# ---- PostgreSQL: usuario de solo lectura (Power BI y aplicación) ----
PG_BI_USER=lector_bi
PG_BI_PASSWORD=cambia_esta_otra_clave

# ---- Kaggle (se usa en la Fase 2) ----
KAGGLE_API_TOKEN=KGAT_tu_token_aqui
